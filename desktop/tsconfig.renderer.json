{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": [
            "node"
        ],
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.cache/typescript/renderer.tsbuildinfo"
    },
    "include": [
        "src/renderer/**/*",
        "src/shared/**/*",
        "src/types/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "out"
    ],
    "references": []
}
