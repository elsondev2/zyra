{
    "name": "zyra-desktop",
    "version": "0.6.0",
    "private": true,
    "description": "Zyra desktop UI for project work, Pi-backed chat, memory, and settings.",
    "main": "./out/main/index.js",
    "author": "Zyra",
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "dev": "node scripts/maint/ensure-electron.mjs && node scripts/maint/dev-runner.mjs",
        "dev:browser": "vite --config vite.browser.config.ts --host 127.0.0.1",
        "build": "electron-vite build",
        "build:browser": "vite build --config vite.browser.config.ts",
        "preview": "electron-vite preview",
        "preview:browser": "vite preview --config vite.browser.config.ts --host 127.0.0.1",
        "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
        "typecheck:browser-runtime": "tsc --noEmit -p tsconfig.browser-runtime.json",
        "test:activity-rail": "bun scripts/test-activity-rail-contract.ts",
        "test:settings": "bun scripts/test-settings-contract.ts",
        "test:themes": "bun scripts/test-theme-contract.ts",
        "test:agent-surface": "bun scripts/test-agent-surface-contract.ts",
        "test:agent-server": "bun scripts/test-agent-server-worker.ts",
        "test:assistant-fleet": "bun scripts/test-assistant-fleet-contract.tsx",
        "test:assistant-inspector-workspaces": "bun scripts/test-assistant-inspector-workspace-state.ts",
        "test:agent-control": "bun scripts/test-agent-control-contract.ts && bun scripts/test-agent-control-policy.ts && bun scripts/test-agent-control-revisions.ts && bun scripts/test-browser-plan-executor.ts && bun scripts/test-zyra-browser-visual-control.ts && bun scripts/test-assistant-control-approval-preferences.ts && bun scripts/test-agent-control-bridge.ts && bun scripts/test-agent-control-audit.ts && bun scripts/test-agent-control-pairing.ts",
        "smoke:browser-visual": "node scripts/maint/run-zyra-browser-visual-smoke.mjs",
        "test:browser-annotation": "bun scripts/test-browser-annotation-composer.ts && node scripts/maint/run-browser-annotation-test.mjs",
        "test:browser-assistant-bridge": "bun scripts/test-browser-assistant-bridge.ts",
        "test:browser-client-host": "bun scripts/test-browser-client-host.ts",
        "test:browser-devscope-live": "bun scripts/test-browser-devscope-live-adapter.ts",
        "test:assistant-diff": "bun scripts/test-assistant-diff-contract.ts",
        "test:assistant-history": "bun scripts/test-assistant-history-persistence.ts && bun scripts/test-assistant-paged-history.ts",
        "test:assistant-canonical-review": "bun scripts/test-assistant-canonical-review.ts",
        "test:assistant-project": "bun scripts/test-assistant-project-lock.ts && bun scripts/test-project-icon-resolver.ts",
        "test:assistant-images": "bun scripts/test-assistant-image-pipeline.ts",
        "test:assistant-account-runtime": "node scripts/test-assistant-account-electron-runtime.mjs",
        "test:onboarding": "bun scripts/test-onboarding-state.ts && bun scripts/test-device-preference-ownership.ts && bun scripts/test-device-secret-renderer-boundary.ts && bun scripts/test-account-connection-actions.ts && bun scripts/test-onboarding-ipc-gate.ts && bun scripts/test-onboarding-renderer-gate.ts && bun scripts/test-onboarding-browser-authorization.ts && bun scripts/test-assistant-web-defaults.ts",
        "test:assistant-markdown": "bun scripts/test-assistant-markdown-cache.tsx",
        "test:assistant-realtime-voice": "bun scripts/test-assistant-realtime-voice.ts",
        "test:assistant-voice-core": "bun scripts/test-assistant-voice-core.ts",
        "test:assistant-voice-transcription": "bun scripts/test-assistant-voice-transcription.ts",
        "test:markdown-links": "bun scripts/test-markdown-link-contract.ts",
        "test:markdown-renderer": "bun scripts/test-markdown-renderer-features.tsx",
        "test:assistant-performance": "bun scripts/test-assistant-history-performance.ts",
        "test:assistant-timeline-scroll": "bun scripts/test-assistant-timeline-scroll.ts",
        "test:file-change-lifecycle": "bun scripts/test-file-change-lifecycle.ts",
        "test:file-preview-navigation": "bun scripts/test-file-preview-navigation.ts",
        "test:file-preview-performance": "bun scripts/test-file-preview-performance.ts",
        "test:pi-assistant-lifecycle": "bun scripts/test-pi-assistant-lifecycle.ts",
        "test:assistant-startup": "bun scripts/test-assistant-startup-connection.ts && bun scripts/test-assistant-shell-startup.tsx",
        "test:assistant-streaming": "bun scripts/test-assistant-message-content.ts && bun scripts/test-assistant-streaming.ts",
        "test:assistant-switching": "bun scripts/test-assistant-session-switching.ts",
        "test:assistant-routing": "bun scripts/test-assistant-chat-routing.ts",
        "test:assistant-new-chat": "bun scripts/test-assistant-new-chat-surface.ts",
        "test:assistant-client-selection": "bun scripts/test-assistant-client-local-selection.ts",
        "maint:loc": "node scripts/maint/check-loc.mjs",
        "maint:loc:strict": "node scripts/maint/check-loc.mjs --strict",
        "postinstall": "node scripts/release/verify-node-pty-install.mjs",
        "build:win": "node scripts/release/package-desktop.mjs --platform=windows",
        "build:unpack": "node scripts/release/package-desktop.mjs --dir=true",
        "brand:assets": "python scripts/maint/generate_branding_assets.py",
        "test:branding": "python scripts/test-branding-assets.py",
        "release:notes": "node scripts/maint/generate-release-notes.mjs",
        "update:test-feed": "node --experimental-strip-types scripts/maint/check-github-update-feed.mjs",
        "update:serve-feed": "node scripts/maint/serve-update-feed.mjs",
        "test:native-abi": "node scripts/release/test-node-pty-electron.mjs",
        "runtime:stage": "node scripts/release/stage-zyra-runtime.mjs",
        "runtime:validate": "node scripts/release/validate-zyra-runtime.mjs",
        "test:packaged-runtime": "bun scripts/test-packaged-runtime-contract.ts",
        "test:updater-release-feed": "bun scripts/test-desktop-updater-release-feed.ts",
        "release:prepare": "node scripts/release/prepare-release-resources.mjs",
        "release:package": "node scripts/release/package-desktop.mjs",
        "release:validate": "node scripts/release/validate-release-assets.mjs",
        "test:release-infra": "bun scripts/test-desktop-release-contract.ts && bun scripts/test-desktop-build-version.ts && bun scripts/test-desktop-updater-release-feed.ts && node scripts/test-release-asset-contract.mjs",
        "test:release-readiness": "bun run test:onboarding && bun run test:assistant-account-runtime && bun run test:pi-assistant-lifecycle && bun run test:assistant-realtime-voice && bun run test:assistant-voice-core && bun run test:browser-assistant-bridge && bun scripts/test-platform-window-chrome.ts && bun scripts/test-platform-terminal-launcher.ts",
        "build:mac": "node scripts/release/package-desktop.mjs --platform=macos",
        "build:linux": "node scripts/release/package-desktop.mjs --platform=linux",
        "test:release-assets": "node scripts/test-release-asset-contract.mjs",
        "native:prepare": "node scripts/release/verify-node-pty-install.mjs",
        "brand:release-assets": "python scripts/maint/generate_branding_assets.py --icons-only",
        "test:build-version": "bun scripts/test-desktop-build-version.ts"
    },
    "dependencies": {
        "@chenglou/pretext": "^0.0.5",
        "@dicebear/core": "^10.4.0",
        "@dicebear/styles": "^10.3.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@legendapp/list": "3.2.0",
        "@monaco-editor/react": "^4.7.0",
        "@pierre/diffs": "^1.1.0-beta.18",
        "ansi-to-html": "^0.7.2",
        "clsx": "^2.1.1",
        "electron-log": "^5.1.7",
        "electron-updater": "^6.8.3",
        "hast-util-to-jsx-runtime": "2.3.6",
        "html-url-attributes": "3.0.1",
        "lucide-react": "^0.469.0",
        "mermaid": "^11.12.3",
        "monaco-editor": "^0.55.1",
        "node-pty": "1.1.0",
        "ogl": "^1.0.11",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.1.1",
        "react-syntax-highlighter": "^16.1.0",
        "recharts": "^3.6.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "simple-git": "^3.31.1",
        "sql.js": "^1.13.0",
        "systeminformation": "^5.23.5",
        "unified": "11.0.5",
        "unist-util-visit": "5.0.0",
        "xterm": "^5.3.0",
        "xterm-addon-fit": "^0.8.0",
        "xterm-addon-web-links": "^0.9.0",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@types/node": "^22.10.5",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^5.1.0",
        "autoprefixer": "^10.4.20",
        "electron": "43.4.0",
        "electron-builder": "26.15.3",
        "electron-vite": "^2.3.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.3",
        "vite": "^5.4.11",
        "vite-plugin-static-copy": "^3.1.4"
    },
    "build": {
        "appId": "app.zyra.desktop",
        "productName": "Zyra",
        "icon": "resources/icon.png",
        "files": [
            "!dist/**",
            "!.release/**",
            "!resources/branding/icons/*-source.png"
        ],
        "asarUnpack": [
            "node_modules/node-pty/**"
        ],
        "npmRebuild": false,
        "directories": {
            "output": "dist"
        },
        "extraResources": [
            {
                "from": "../LICENSE",
                "to": "LICENSE"
            },
            {
                "from": ".release/zyra-runtime",
                "to": "zyra-runtime",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": ".release/zyra-runtime/node_modules",
                "to": "zyra-runtime/node_modules",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "../extensions/zyra-browser-control/dist/unpacked",
                "to": "zyra-browser-control-extension",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "publish": [
            {
                "provider": "github",
                "owner": "justelson",
                "repo": "zyra"
            }
        ],
        "generateUpdatesFilesForAllChannels": true,
        "fileAssociations": [
            {
                "name": "Code and Text File",
                "description": "Open with Zyra quick preview",
                "role": "Viewer",
                "icon": "resources/icon",
                "ext": [
                    "md",
                    "markdown",
                    "mdx",
                    "txt",
                    "log",
                    "js",
                    "jsx",
                    "mjs",
                    "cjs",
                    "ts",
                    "tsx",
                    "json",
                    "jsonc",
                    "json5",
                    "css",
                    "scss",
                    "less",
                    "html",
                    "htm",
                    "xml",
                    "yml",
                    "yaml",
                    "toml",
                    "ini",
                    "conf",
                    "sh",
                    "bash",
                    "zsh",
                    "ps1",
                    "bat",
                    "cmd",
                    "py",
                    "rb",
                    "php",
                    "java",
                    "kt",
                    "kts",
                    "c",
                    "h",
                    "cpp",
                    "cxx",
                    "hpp",
                    "cs",
                    "go",
                    "rs",
                    "swift",
                    "dart",
                    "scala",
                    "sql",
                    "vue",
                    "svelte",
                    "gradle"
                ]
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Zyra-${version}-windows-${arch}-setup.${ext}",
            "icon": "resources/icon.ico",
            "extraResources": [
                {
                    "from": ".release/zyra-computer-use/win-x64",
                    "to": "zyra-computer-use",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "include": "build/installer.nsh",
            "installerIcon": "resources/icon.ico",
            "uninstallerIcon": "resources/icon.ico",
            "differentialPackage": true
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "universal"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "artifactName": "Zyra-${version}-macos-${arch}.${ext}",
            "x64ArchFiles": "Contents/Resources/zyra-runtime/node_modules/**/*darwin-{arm64,x64}*/**/*",
            "icon": "resources/icon.icns",
            "category": "public.app-category.developer-tools",
            "hardenedRuntime": true,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.inherit.plist",
            "gatekeeperAssess": false,
            "notarize": false,
            "extendInfo": {
                "NSMicrophoneUsageDescription": "Zyra uses the microphone only when you start a voice conversation or transcription."
            }
        },
        "dmg": {
            "sign": false
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "Zyra-${version}-linux-${arch}.${ext}",
            "icon": "resources/icons",
            "category": "Development",
            "maintainer": "Zyra",
            "synopsis": "Local Zyra coding assistant desktop application"
        }
    },
    "homepage": "https://github.com/justelson/zyra"
}
