{
  "manifest_version": 3,
  "name": "Zyra Browser Control",
  "version": "0.1.0",
  "description": "Pairs one explicitly selected Chrome tab with the local Zyra desktop control broker.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "Pair this tab with Zyra",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
