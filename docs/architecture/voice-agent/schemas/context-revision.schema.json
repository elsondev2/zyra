{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyra.dev/schemas/voice-agent/context-revision.schema.json",
  "title": "Zyra context revision",
  "type": "object",
  "required": [
    "schema_version",
    "conversation_id",
    "version",
    "parent_version",
    "scope",
    "actor",
    "changes",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "conversation_id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/contextVersion" },
    "parent_version": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/contextVersion" },
        { "type": "null" }
      ]
    },
    "scope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["conversation", "task", "task_subtree", "agent_run"]
        },
        "target_id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "conversation" } },
            "required": ["kind"]
          },
          "then": {
            "not": {
              "properties": { "target_id": true },
              "required": ["target_id"]
            }
          },
          "else": {
            "properties": { "target_id": { "$ref": "common.schema.json#/$defs/id" } },
            "required": ["target_id"]
          }
        }
      ],
      "additionalProperties": false
    },
    "actor": { "$ref": "common.schema.json#/$defs/actor" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["change_id", "kind", "content"],
        "properties": {
          "change_id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": {
            "type": "string",
            "enum": [
              "constraint.added",
              "constraint.replaced",
              "constraint.removed",
              "correction.recorded",
              "decision.recorded",
              "decision.superseded",
              "approval.reference.updated",
              "preference.changed",
              "focus.changed",
              "assumption.confirmed",
              "assumption.rejected",
              "attachment.added",
              "task.linked"
            ]
          },
          "content": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": true
          },
          "supersedes_change_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "propagate_to_descendants": {
            "type": "boolean",
            "default": true
          },
          "source_refs": {
            "type": "array",
            "maxItems": 32,
            "items": { "$ref": "common.schema.json#/$defs/sourceRef" }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "approval.reference.updated" } },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "content": {
                  "type": "object",
                  "required": ["approval_request_id", "status"],
                  "properties": {
                    "approval_request_id": { "$ref": "common.schema.json#/$defs/id" },
                    "status": { "type": "string", "enum": ["pending", "resolved", "expired", "cancelled"] }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
