{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyra.dev/schemas/voice-agent/common.schema.json",
  "title": "Zyra voice-agent common definitions",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "contextVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actor": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["user", "foreground", "controller", "primary", "subagent", "permission_gate", "system"]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": ["artifact_id", "kind", "uri", "label"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/id" },
        "kind": {
          "type": "string",
          "enum": ["file", "diff", "test_result", "command_result", "image", "web_source", "report", "worktree", "other"]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "private": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["message", "task_event", "execution_attempt", "operation", "completion_candidate", "agent_record", "artifact", "context_revision", "decision_request", "approval_request", "capability_lease", "narration_delivery", "checkpoint", "web_source"]
        },
        "id": { "$ref": "#/$defs/id" },
        "uri": {
          "type": "string",
          "maxLength": 2048
        },
        "excerpt": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean"
        },
        "outcome_unknown": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cached_input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "reasoning_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "requests": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
