{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyra.dev/schemas/voice-agent/decision-request.schema.json",
  "title": "Zyra user decision request",
  "type": "object",
  "required": [
    "schema_version",
    "decision_request_id",
    "revision",
    "previous_revision",
    "conversation_id",
    "task_id",
    "context_version",
    "status",
    "question",
    "why_user_needed",
    "options",
    "recommended_option_id",
    "recommendation_rationale",
    "involvement_mode",
    "requested_by",
    "resolution",
    "superseded_by_decision_request_id",
    "created_at",
    "terminal_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "decision_request_id": { "$ref": "common.schema.json#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "previous_revision": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "conversation_id": { "$ref": "common.schema.json#/$defs/id" },
    "task_id": { "$ref": "common.schema.json#/$defs/id" },
    "context_version": { "$ref": "common.schema.json#/$defs/contextVersion" },
    "status": {
      "type": "string",
      "enum": ["pending", "resolved", "cancelled", "superseded"]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "why_user_needed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["option_id", "label", "description", "consequences"],
        "properties": {
          "option_id": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "consequences": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "additionalProperties": false
      }
    },
    "recommended_option_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/id" },
        { "type": "null" }
      ]
    },
    "recommendation_rationale": {
      "type": "string",
      "maxLength": 2000
    },
    "involvement_mode": {
      "type": "string",
      "enum": ["mostly_autonomous", "balanced", "highly_collaborative", "tightly_controlled"]
    },
    "requested_by": { "$ref": "common.schema.json#/$defs/actor" },
    "resolution": {
      "oneOf": [
        {
          "type": "object",
          "required": ["selected_option_id", "resolved_by", "resolved_at"],
          "properties": {
            "selected_option_id": { "$ref": "common.schema.json#/$defs/id" },
            "freeform_answer": { "type": "string", "maxLength": 10000 },
            "resolved_by": { "$ref": "common.schema.json#/$defs/actor" },
            "resolved_at": { "$ref": "common.schema.json#/$defs/timestamp" }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "superseded_by_decision_request_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/id" },
        { "type": "null" }
      ]
    },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "terminal_at": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/timestamp" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "revision": { "const": 1 } },
        "required": ["revision"]
      },
      "then": { "properties": { "previous_revision": { "type": "null" } } },
      "else": { "properties": { "previous_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } } }
    },
    {
      "if": {
        "properties": { "status": { "const": "pending" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "resolution": { "type": "null" },
          "superseded_by_decision_request_id": { "type": "null" },
          "terminal_at": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "resolved" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "resolution": { "type": "object" },
          "superseded_by_decision_request_id": { "type": "null" },
          "terminal_at": { "$ref": "common.schema.json#/$defs/timestamp" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "superseded" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "resolution": { "type": "null" },
          "superseded_by_decision_request_id": { "$ref": "common.schema.json#/$defs/id" },
          "terminal_at": { "$ref": "common.schema.json#/$defs/timestamp" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "cancelled" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "resolution": { "type": "null" },
          "superseded_by_decision_request_id": { "type": "null" },
          "terminal_at": { "$ref": "common.schema.json#/$defs/timestamp" }
        }
      }
    }
  ],
  "additionalProperties": false
}
