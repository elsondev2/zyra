{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyra.dev/schemas/voice-agent/usage-snapshot.schema.json",
  "title": "Zyra split usage snapshot",
  "type": "object",
  "required": ["schema_version", "conversation_id", "voice", "agent_work", "observed_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "conversation_id": { "$ref": "common.schema.json#/$defs/id" },
    "voice": {
      "type": "object",
      "required": ["provider", "status", "metering_source"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["unknown", "normal", "approaching", "exhausted", "unlimited", "error"] },
        "metering_source": { "type": "string", "enum": ["provider", "local_estimate", "provider_and_local_estimate"] },
        "elapsed_seconds_estimate": { "type": "number", "minimum": 0 },
        "remaining_seconds": { "type": "number", "minimum": 0 },
        "window_seconds": { "type": "number", "minimum": 1 },
        "resets_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "fair_use_applies": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "agent_work": {
      "type": "object",
      "required": ["provider", "status", "metering_source"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["unknown", "normal", "approaching", "exhausted", "unlimited", "error"] },
        "metering_source": { "type": "string", "enum": ["provider", "local_estimate", "provider_and_local_estimate"] },
        "used_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "window_seconds": { "type": "number", "minimum": 1 },
        "resets_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "model": { "type": "string", "maxLength": 128 },
        "usage": { "$ref": "common.schema.json#/$defs/usage" }
      },
      "additionalProperties": false
    },
    "observed_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
