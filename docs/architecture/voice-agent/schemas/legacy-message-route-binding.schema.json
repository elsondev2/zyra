{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyra.dev/schemas/voice-agent/legacy-message-route-binding.schema.json",
  "title": "Zyra legacy canonical-message route binding",
  "type": "object",
  "required": [
    "schema_version",
    "binding_id",
    "migration_id",
    "conversation_id",
    "message_id",
    "role",
    "modality",
    "foreground_route_id",
    "route_epoch",
    "canonical_commit_receipt_id",
    "source_session_ref",
    "source_sequence",
    "source_record_sha256",
    "migration_manifest_sha256",
    "message_created_at",
    "bound_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "binding_id": { "$ref": "common.schema.json#/$defs/id" },
    "migration_id": { "$ref": "common.schema.json#/$defs/id" },
    "conversation_id": { "$ref": "common.schema.json#/$defs/id" },
    "message_id": { "$ref": "common.schema.json#/$defs/id" },
    "role": { "type": "string", "enum": ["user", "assistant"] },
    "modality": { "type": "string", "enum": ["text", "speech", "image", "multimodal"] },
    "foreground_route_id": { "$ref": "common.schema.json#/$defs/id" },
    "route_epoch": { "const": 1 },
    "canonical_commit_receipt_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/id" },
        { "type": "null" }
      ]
    },
    "source_session_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "source_sequence": { "type": "integer", "minimum": 1 },
    "source_record_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "migration_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "message_created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "bound_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "assistant" } }, "required": ["role"] },
      "then": { "properties": { "canonical_commit_receipt_id": { "$ref": "common.schema.json#/$defs/id" } } },
      "else": { "properties": { "canonical_commit_receipt_id": { "type": "null" } } }
    }
  ],
  "additionalProperties": false
}
