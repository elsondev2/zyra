{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyra.dev/schemas/voice-agent/completion-candidate.schema.json",
  "title": "Zyra primary completion candidate",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "conversation_id",
    "task_id",
    "attempt_id",
    "primary_agent_run_id",
    "context_version",
    "outcome_summary",
    "acceptance_results",
    "changed_artifacts",
    "tests",
    "remaining_assumptions",
    "fallback_behavior",
    "known_gaps",
    "context_acknowledgements",
    "cleanup",
    "retained_worktrees",
    "suggested_user_summary",
    "suggested_speakable_summary",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "$ref": "common.schema.json#/$defs/id" },
    "conversation_id": { "$ref": "common.schema.json#/$defs/id" },
    "task_id": { "$ref": "common.schema.json#/$defs/id" },
    "attempt_id": { "$ref": "common.schema.json#/$defs/id" },
    "primary_agent_run_id": { "$ref": "common.schema.json#/$defs/id" },
    "context_version": { "$ref": "common.schema.json#/$defs/contextVersion" },
    "outcome_summary": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "acceptance_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["criterion_id", "status", "evidence_refs"],
        "properties": {
          "criterion_id": { "$ref": "common.schema.json#/$defs/id" },
          "status": { "type": "string", "enum": ["passed", "failed", "waived"] },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": { "$ref": "common.schema.json#/$defs/sourceRef" }
          }
        },
        "additionalProperties": false
      }
    },
    "changed_artifacts": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "common.schema.json#/$defs/artifactRef" }
    },
    "tests": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["name", "status", "summary", "evidence_refs"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "status": { "type": "string", "enum": ["passed", "failed", "not_run"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence_refs": {
            "type": "array",
            "maxItems": 32,
            "items": { "$ref": "common.schema.json#/$defs/sourceRef" }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "enum": ["passed", "failed"] } },
              "required": ["status"]
            },
            "then": { "properties": { "evidence_refs": { "type": "array", "minItems": 1 } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "remaining_assumptions": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "fallback_behavior": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "known_gaps": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "context_acknowledgements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["owner_kind", "owner_id", "context_version", "relevant_change_ids", "acknowledged_at"],
        "properties": {
          "owner_kind": { "type": "string", "enum": ["primary", "subagent"] },
          "owner_id": { "$ref": "common.schema.json#/$defs/id" },
          "context_version": { "$ref": "common.schema.json#/$defs/contextVersion" },
          "relevant_change_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/id" }
          },
          "acknowledged_at": { "$ref": "common.schema.json#/$defs/timestamp" }
        },
        "additionalProperties": false
      }
    },
    "cleanup": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["item", "status", "evidence_refs"],
        "properties": {
          "item": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "status": { "type": "string", "enum": ["complete", "pending", "retained_intentionally"] },
          "evidence_refs": {
            "type": "array",
            "maxItems": 32,
            "items": { "$ref": "common.schema.json#/$defs/sourceRef" }
          }
        },
        "additionalProperties": false
      }
    },
    "retained_worktrees": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "common.schema.json#/$defs/artifactRef" }
    },
    "suggested_user_summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "suggested_speakable_summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
